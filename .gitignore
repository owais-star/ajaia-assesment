.env
.env*.local
*.pem
*.key

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# OS metadata
.DS_Store
Thumbs.db
ehthumbs.db

